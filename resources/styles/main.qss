QMainWindow {
    background: qlineargradient(
        x1:0, y1:0,
        x2:1, y2:1,
        stop:0 #031B1A,
        stop:0.5 #062E2D,
        stop:1 #021111
    );
}

#loginTitle {
    color: white;
    font-size: 42px;
    font-weight: bold;
    background: transparent;
    font-family: Segou UI;
}

#loginSubtitle {
    color: white;
    font-size: 28px;
    font-weight: bold;
    background: transparent;
}

#loginCard {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #BFC4FF,
        stop:1 #5661DD
    );
    border-radius: 18px;
}

#loginEdit {
    background-color: rgba(255, 255, 255, 0.08);
    border: 2px solid transparent;
    border-radius: 12px;
    padding: 12px 16px;

    color: black;
    font-size: 23px;

    selection-background-color: #6C7BFF;
}

#loginEdit:hover {
    border: 2px solid rgba(255,255,255,0.15);
}

#loginButton {
    background-color: #6C7BFF;
    color: white;

    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px;

    font-size: 18px;
    font-weight: 600;

    padding: 12px 16px;
}

#loginButton:hover {
    background-color: #7D8BFF;
    border: 1px solid rgba(255,255,255,0.18);
}

#loginButton:pressed {
    background-color: #5661DD;
}

#loginButton:disabled {
    background-color: #3A3D44;
    color: #888888;
}

#playerCard {
    background-color: rgba(0,0,0,0.2);
    border-radius: 18px;
}

#nicknameLabel{
    color: white;
    font-size: 35px;
    font-weight: bold;
    background: transparent;
    font-family: Segou UI;
}


#readyButton {
    background-color: #6C7BFF;
    color: white;

    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px;

    font-size: 28px;
    font-weight: 600;

    padding: 12px 16px;
}

#readyButton:hover {
    background-color: #7D8BFF;
    border: 1px solid rgba(255,255,255,0.18);
}

#readyButton:pressed {
    background-color: #5661DD;
}

#balanceLabel{
    color: #FFD166;

    font-size: 18px;
    font-weight: 700;

    padding: 6px 14px;

    background: qlineargradient(
        x1:0, y1:0,
        x2:1, y2:1,
        stop:0 rgba(255,209,102,0.10),
        stop:1 rgba(255,209,102,0.03)
    );

    border: 1px solid rgba(255,209,102,0.18);

    border-radius: 12px;
}


#nicknameGameLabel{
    color: white;
    font-size: 27px;
    font-weight: bold;
    background: transparent;
    font-family: Segou UI;
}

#diceWidget {
    background-color: rgba(0,0,0,0.18);

    border-radius: 18px;
    border: 1px solid rgba(255,255,255,0.05);
}

#diceWidget:hover {
    background-color: rgba(255,255,255,0.03);

    border: 1px solid rgba(255,255,255,0.10);
}

#diceLabel {
    background: transparent;
}

#diceHint {
    color: rgba(255,255,255,0.65);

    font-size: 14px;

    background: transparent;
}


#eventChatArea {
    background-color: rgba(20, 24, 40, 0.88);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 18px;
}

#eventsView {
    background: transparent;
    border: none;

    color: rgba(255,255,255,0.92);

    font-size: 15px;
}

#chatInput {
    background-color: rgba(0,0,0,0.22);

    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 12px;

    padding: 10px 14px;

    color: white;

    font-size: 15px;
}

#chatInput:focus {
    border: 1px solid #7B8CFF;
    background-color: rgba(255,255,255,0.05);
}

#readyLabel
{
    background: rgba(255,255,255,0.04);

    border-radius: 12px;


    font-size: 24px;
    font-weight: 700;

    font-family: "Segoe UI";

    min-width: 160px;
    max-width: 160px;
}

#waitingLabel
{
    color: white;
    font-size: 27px;
    font-weight: bold;
    background: transparent;
    font-family: Segou UI;
}

QLabel[ready="true"]
{
    color: #6EE7A8;

    border: 1px solid rgba(110,231,168,0.25);

    background: rgba(110,231,168,0.08);
}

QLabel[ready="false"]
{
    color: #FF7B7B;

    border: 1px solid rgba(255,123,123,0.25);

    background: rgba(255,123,123,0.08);
}

QMessageBox
{
    background-color: #1B1F36;
    border: 1px solid rgba(255,255,255,0.10);
}

QMessageBox QLabel
{
    color: white;
    background: transparent;

    font-family: "Segoe UI";
    font-size: 16px;
    font-weight: 600;
}

QMessageBox QLabel#qt_msgbox_label
{
    min-width: 440px;
    max-width: 440px;

    padding: 16px;

    color: white;

    font-size: 16px;
    font-weight: 500;
}

QMessageBox QPushButton
{
    background-color: rgba(255,255,255,0.08);
    color: white;

    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 12px;

    min-width: 120px;
    min-height: 38px;

    font-size: 14px;
    font-weight: 700;
}

QMessageBox QPushButton:hover
{
    background-color: rgba(255,255,255,0.15);
}

QMessageBox QPushButton:pressed
{
    background-color: rgba(255,255,255,0.22);
}

#settingsButton
{
    background-color: rgba(255,255,255,0.08);
    color: white;

    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 26px;

    font-size: 24px;
    font-weight: 700;
}

#settingsButton:hover
{
    background-color: rgba(255,255,255,0.14);
}

#settingsButton:pressed
{
    background-color: rgba(255,255,255,0.22);
}

#settingsDialog
{
    background-color: #1B1F36;
}

#settingsTitle
{
    color: white;
    font-size: 28px;
    font-weight: 800;
}

#settingsLabel
{
    color: rgba(255,255,255,0.85);
    font-size: 17px;
    font-weight: 600;
}

#settingsValue
{
    color: white;
    font-size: 16px;
    font-weight: 700;
    min-width: 52px;
}

#settingsCloseButton
{
    background-color: #6C7BFF;
    color: white;

    border: none;
    border-radius: 14px;

    min-height: 44px;

    font-size: 16px;
    font-weight: 700;
}

#settingsCloseButton:hover
{
    background-color: #7D8AFF;
}

#settingsCloseButton:pressed
{
    background-color: #5A69EE;
}

#settingsSlider::groove:horizontal
{
    height: 8px;
    background: rgba(255,255,255,0.14);
    border-radius: 4px;
}

#settingsSlider::handle:horizontal
{
    width: 22px;
    height: 22px;
    margin: -7px 0;
    border-radius: 11px;
    background: #6C7BFF;
}

#settingsSlider::sub-page:horizontal
{
    background: #6C7BFF;
    border-radius: 4px;
}

#purchaseOfferDialog,
#auctionDialog
{
    background-color: #1B1F36;

    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 18px;
}

#purchasePrice,
#auctionBidLabel
{
    color: rgba(255,255,255,0.88);
    background: transparent;

    font-family: "Segoe UI";
    font-size: 17px;
    font-weight: 600;

    min-height: 30px;
    max-height: 30px;
}

#purchasePrice,
#auctionBidLabel
{
    color: rgba(255,255,255,0.88);
    background: transparent;

    font-family: "Segoe UI";
    font-size: 17px;
    font-weight: 600;

    min-height: 30px;
}

#auctionTimer
{
    color: #FFD166;
    background-color: rgba(255,209,102,0.10);

    border: 1px solid rgba(255,209,102,0.20);
    border-radius: 14px;

    font-family: "Segoe UI";
    font-size: 22px;
    font-weight: 900;

    min-height: 44px;
    max-height: 44px;

    padding: 4px 14px;
}

#auctionBidInput
{
    background-color: rgba(0,0,0,0.26);
    color: white;

    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 12px;

    padding: 0 14px;

    min-height: 46px;
    max-height: 46px;

    font-family: "Segoe UI";
    font-size: 18px;
    font-weight: 700;
}

#auctionBidInput:focus
{
    border: 1px solid #7B8CFF;
    background-color: rgba(255,255,255,0.06);
}

#primaryDialogButton
{
    background-color: #6C7BFF;
    color: white;

    border: none;
    border-radius: 14px;

    min-height: 46px;
    max-height: 46px;

    font-family: "Segoe UI";
    font-size: 16px;
    font-weight: 800;
}

#primaryDialogButton:hover
{
    background-color: #7D8AFF;
}

#primaryDialogButton:pressed
{
    background-color: #5661DD;
}

#secondaryDialogButton
{
    background-color: rgba(255,255,255,0.08);
    color: white;

    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 14px;

    min-height: 46px;

    font-size: 16px;
    font-weight: 800;
}

#secondaryDialogButton:hover
{
    background-color: rgba(255,255,255,0.14);
}

#secondaryDialogButton:pressed
{
    background-color: rgba(255,255,255,0.22);
}


#primaryDialogButton:disabled {
    background-color: rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.35);
    border: 1px solid rgba(255,255,255,0.10);
}

QMenu
{
    background-color: #1B1F36;
    color: white;

    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 10px;

    padding: 6px;
}

QMenu::item
{
    background: transparent;

    padding: 9px 26px 9px 14px;

    border-radius: 8px;

    font-size: 14px;
    font-weight: 600;
}

QMenu::item:selected
{
    background-color: rgba(108,123,255,0.28);
}

QMenu::item:disabled
{
    color: rgba(255,255,255,0.35);
}

QMenu::separator
{
    height: 1px;
    background: rgba(255,255,255,0.10);
    margin: 6px 4px;
}

